{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "cli/**/*.ts", "mcp/**/*.ts", "runner/**/*.ts", "local/**/*.ts", "adapters/**/*.ts", "replay/**/*.ts", "demo/**/*.ts", "deploy/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
